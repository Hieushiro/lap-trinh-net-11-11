using System;
using System.Collections.Generic;
using System.Data;

namespace bai6._1
{
    public class BUS
    {
        private DAL dal = new DAL();

        public DataTable LayDanhSach(string tenBang) => dal.GetDanhSach(tenBang);
        public DataTable TimSanPham(string kw) => dal.TimKiemSanPham(kw);

        public string ThemSanPham(SanPhamDTO sp)
        {
            if (string.IsNullOrWhiteSpace(sp.MaSP) || string.IsNullOrWhiteSpace(sp.TenSP))
                return "Mã và tên sản phẩm không được để trống!";
            if (sp.GiaBan <= 0 || sp.SoLuongTon < 0)
                return "Giá bán phải > 0 và tồn kho >= 0!";

            return dal.ThemSanPham(sp) ? "Thêm thành công!" : "Thêm thất bại!";
        }

        public string SuaSanPham(SanPhamDTO sp)
        {
            if (string.IsNullOrWhiteSpace(sp.MaSP)) return "Vui lòng chọn sản phẩm cần sửa!";
            return dal.SuaSanPham(sp) ? "Cập nhật thành công!" : "Cập nhật thất bại!";
        }

        public string XoaSanPham(string maSP)
        {
            if (string.IsNullOrWhiteSpace(maSP)) return "Vui lòng chọn sản phẩm cần xóa!";
            return dal.XoaSanPham(maSP) ? "Xóa thành công!" : "Xóa thất bại (có thể sản phẩm đã có trong hóa đơn)!";
        }

        public string ThanhToan(int maNV, int? maKH, List<ChiTietHoaDonDTO> gioHang)
        {
            if (gioHang == null || gioHang.Count == 0)
                return "Giỏ hàng đang trống!";

            decimal tongTien = 0;
            foreach (var item in gioHang) tongTien += item.ThanhTien;

            if (dal.ThanhToanHoaDon(maNV, maKH, tongTien, gioHang, out string loi))
                return "Thanh toán thành công! Đã trừ tồn kho và cộng điểm.";
            else
                return "Lỗi giao dịch (Đã Rollback): " + loi;
        }

        public decimal LayDoanhThuNgay() => dal.GetDoanhThuNgay();
        public decimal LayDoanhThuThang() => dal.GetDoanhThuThang();
        public DataTable LayTop5SanPham() => dal.GetTop5SanPham();
    }
}





          
