using System;
using System.Collections.Generic;
using System.Data;
using System.Data.SqlClient;

namespace bai6._1
{
    public class DAL
    {
        // Thay chuỗi kết nối này bằng Server Name của máy bạn
        private string strConn = @"Data Source=DESKTOP-4HMO9V9\SQLEXPRESS;Initial Catalog=SalesDB;Integrated Security=True;TrustServerCertificate=True";


        // Lấy dữ liệu cho ComboBox và DataGridView
        public DataTable GetDanhSach(string tenBang)
        {
            using (SqlConnection conn = new SqlConnection(strConn))
            {
                string sql = $"SELECT * FROM {tenBang}";
                SqlDataAdapter da = new SqlDataAdapter(sql, conn);
                DataTable dt = new DataTable();
                da.Fill(dt);
                return dt;
            }
        }

        // Tìm kiếm sản phẩm theo tên hoặc mã dùng SqlParameter có ký tự đại diện %
        public DataTable TimKiemSanPham(string keyword)
        {
            using (SqlConnection conn = new SqlConnection(strConn))
            {
                string sql = "SELECT * FROM SanPham WHERE TenSP LIKE @kw OR MaSP LIKE @kw";
                SqlCommand cmd = new SqlCommand(sql, conn);
                cmd.Parameters.AddWithValue("@kw", "%" + keyword + "%");

                SqlDataAdapter da = new SqlDataAdapter(cmd);
                DataTable dt = new DataTable();
                da.Fill(dt);
                return dt;
            }
        }

        // Thêm Sản Phẩm
        public bool ThemSanPham(SanPhamDTO sp)
        {
            using (SqlConnection conn = new SqlConnection(strConn))
            {
                conn.Open();
                string sql = "INSERT INTO SanPham (MaSP, TenSP, GiaBan, SoLuongTon) VALUES (@ma, @ten, @gia, @ton)";
                SqlCommand cmd = new SqlCommand(sql, conn);
                cmd.Parameters.AddWithValue("@ma", sp.MaSP);
                cmd.Parameters.AddWithValue("@ten", sp.TenSP);
                cmd.Parameters.AddWithValue("@gia", sp.GiaBan);
                cmd.Parameters.AddWithValue("@ton", sp.SoLuongTon);
                return cmd.ExecuteNonQuery() > 0;
            }
        }

        // Sửa Sản Phẩm
        public bool SuaSanPham(SanPhamDTO sp)
        {
            using (SqlConnection conn = new SqlConnection(strConn))
            {
                conn.Open();
                string sql = "UPDATE SanPham SET TenSP = @ten, GiaBan = @gia, SoLuongTon = @ton WHERE MaSP = @ma";
                SqlCommand cmd = new SqlCommand(sql, conn);
                cmd.Parameters.AddWithValue("@ma", sp.MaSP);
                cmd.Parameters.AddWithValue("@ten", sp.TenSP);
                cmd.Parameters.AddWithValue("@gia", sp.GiaBan);
                cmd.Parameters.AddWithValue("@ton", sp.SoLuongTon);
                return cmd.ExecuteNonQuery() > 0;
            }
        }

        // Xóa Sản Phẩm
        public bool XoaSanPham(string maSP)
        {
            using (SqlConnection conn = new SqlConnection(strConn))
            {
                conn.Open();
                string sql = "DELETE FROM SanPham WHERE MaSP = @ma";
                SqlCommand cmd = new SqlCommand(sql, conn);
                cmd.Parameters.AddWithValue("@ma", maSP);
                return cmd.ExecuteNonQuery() > 0;
            }
        }

        // Xử lý Thanh toán dùng SqlTransaction
        public bool ThanhToanHoaDon(int maNV, int? maKH, decimal tongTien, List<ChiTietHoaDonDTO> gioHang, out string loi)
        {
            loi = "";
            using (SqlConnection conn = new SqlConnection(strConn))
            {
                conn.Open();
                SqlTransaction trans = conn.BeginTransaction();

                try
                {
                    string sqlHD = "INSERT INTO HoaDon (MaNV, MaKH, TongTien) OUTPUT INSERTED.MaHD VALUES (@maNV, @maKH, @tongTien)";
                    SqlCommand cmdHD = new SqlCommand(sqlHD, conn, trans);
                    cmdHD.Parameters.AddWithValue("@maNV", maNV);
                    cmdHD.Parameters.AddWithValue("@maKH", (object)maKH ?? DBNull.Value);
                    cmdHD.Parameters.AddWithValue("@tongTien", tongTien);
                    int maHD = (int)cmdHD.ExecuteScalar();

                    foreach (var item in gioHang)
                    {
                        string sqlCheck = "SELECT SoLuongTon FROM SanPham WHERE MaSP = @maSP";
                        SqlCommand cmdCheck = new SqlCommand(sqlCheck, conn, trans);
                        cmdCheck.Parameters.AddWithValue("@maSP", item.MaSP);
                        int tonKho = (int)cmdCheck.ExecuteScalar();

                        if (tonKho < item.SoLuong)
                            throw new Exception($"Sản phẩm {item.TenSP} không đủ tồn kho (Còn: {tonKho})!");

                        string sqlCT = "INSERT INTO ChiTietHoaDon (MaHD, MaSP, SoLuong, DonGia) VALUES (@maHD, @maSP, @sl, @gia)";
                        SqlCommand cmdCT = new SqlCommand(sqlCT, conn, trans);
                        cmdCT.Parameters.AddWithValue("@maHD", maHD);
                        cmdCT.Parameters.AddWithValue("@maSP", item.MaSP);
                        cmdCT.Parameters.AddWithValue("@sl", item.SoLuong);
                        cmdCT.Parameters.AddWithValue("@gia", item.DonGia);
                        cmdCT.ExecuteNonQuery();

                        string sqlTru = "UPDATE SanPham SET SoLuongTon = SoLuongTon - @sl WHERE MaSP = @maSP";
                        SqlCommand cmdTru = new SqlCommand(sqlTru, conn, trans);
                        cmdTru.Parameters.AddWithValue("@sl", item.SoLuong);
                        cmdTru.Parameters.AddWithValue("@maSP", item.MaSP);
                        cmdTru.ExecuteNonQuery();
                    }

                    if (maKH.HasValue)
                    {
                        int diemCong = (int)(tongTien / 100000);
                        if (diemCong > 0)
                        {
                            string sqlDiem = "UPDATE KhachHang SET DiemTichLuy = DiemTichLuy + @diem WHERE MaKH = @maKH";
                            SqlCommand cmdDiem = new SqlCommand(sqlDiem, conn, trans);
                            cmdDiem.Parameters.AddWithValue("@diem", diemCong);
                            cmdDiem.Parameters.AddWithValue("@maKH", maKH.Value);
                            cmdDiem.ExecuteNonQuery();
                        }
                    }

                    trans.Commit();
                    return true;
                }
                catch (Exception ex)
                {
                    trans.Rollback();
                    loi = ex.Message;
                    return false;
                }
            }
        }

        // Thống kê doanh thu ngày dùng ExecuteScalar
        public decimal GetDoanhThuNgay()
        {
            using (SqlConnection conn = new SqlConnection(strConn))
            {
                conn.Open();
                string sql = "SELECT ISNULL(SUM(TongTien), 0) FROM HoaDon WHERE CAST(NgayLap AS DATE) = CAST(GETDATE() AS DATE)";
                SqlCommand cmd = new SqlCommand(sql, conn);
                return Convert.ToDecimal(cmd.ExecuteScalar());
            }
        }

        // Thống kê doanh thu tháng dùng ExecuteScalar
        public decimal GetDoanhThuThang()
        {
            using (SqlConnection conn = new SqlConnection(strConn))
            {
                conn.Open();
                string sql = "SELECT ISNULL(SUM(TongTien), 0) FROM HoaDon WHERE MONTH(NgayLap) = MONTH(GETDATE()) AND YEAR(NgayLap) = YEAR(GETDATE())";
                SqlCommand cmd = new SqlCommand(sql, conn);
                return Convert.ToDecimal(cmd.ExecuteScalar());
            }
        }

        // Lấy Top 5 sản phẩm bán chạy dùng SqlDataReader
        public DataTable GetTop5SanPham()
        {
            DataTable dt = new DataTable();
            dt.Columns.Add("MaSP");
            dt.Columns.Add("TenSP");
            dt.Columns.Add("TongBan", typeof(int));

            using (SqlConnection conn = new SqlConnection(strConn))
            {
                conn.Open();
                string sql = @"SELECT TOP 5 sp.MaSP, sp.TenSP, SUM(ct.SoLuong) AS TongBan 
                               FROM ChiTietHoaDon ct JOIN SanPham sp ON ct.MaSP = sp.MaSP 
                               GROUP BY sp.MaSP, sp.TenSP ORDER BY TongBan DESC";
                SqlCommand cmd = new SqlCommand(sql, conn);
                using (SqlDataReader reader = cmd.ExecuteReader())
                {
                    while (reader.Read())
                    {
                        dt.Rows.Add(reader["MaSP"], reader["TenSP"], reader["TongBan"]);
                    }
                }
            }
            return dt;
        }
    }
}






          
